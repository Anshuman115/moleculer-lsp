{
  "name": "moleculer-lsp",
  "version": "0.1.0",
  "description": "Language server for Moleculer.js — go to definition, references, diagnostics",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --noEmit && npm run bundle",
    "bundle": "esbuild src/main.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/main.js --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
